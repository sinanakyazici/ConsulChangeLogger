<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>ConsulChangeLogger.Tests</AssemblyName>
    <RootNamespace>ConsulChangeLogger.Tests</RootNamespace>
    <Product>Consul Change Logger</Product>
    <AssemblyTitle>ConsulChangeLogger.Tests</AssemblyTitle>
    <CoverletOutputFormat>opencover</CoverletOutputFormat>
    <CoverletOutput>TestResults/coverage.opencover.xml</CoverletOutput>
    <ExcludeByFile>**/Program.cs%2c**/Authentication/AuthenticationEndpoints.cs%2c**/Authentication/LdapAuthenticator.cs%2c**/Authentication/LoginPage.cs%2c**/Authentication/UserSession.cs%2c**/ChangeLogging/ChangeRecordDispatchWorker.cs%2c**/ChangeLogging/ChangeRecordSink.cs%2c**/Configuration/ConsulConfigLoader.cs%2c**/Core/ChangeRecord.cs%2c**/Health/*.cs%2c**/Proxying/ConsulProxy.cs%2c**/Proxying/JsonValidationClientScript.cs%2c**/Security/SecurityHeadersMiddleware.cs</ExcludeByFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.msbuild" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ConsulChangeLogger.Proxy\ConsulChangeLogger.Proxy.csproj" />
  </ItemGroup>
</Project>
